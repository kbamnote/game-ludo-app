{
  "expo": {
    "name": "CGP - Cockroach Game Party",
    "slug": "cgp-cockroach-game-party",
    "scheme": "cgp",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0f19",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a selfie for your Ludo character.",
          "cameraPermission": false,
          "microphonePermission": "Use your microphone when you unmute in a Ludo voice room."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#1649a0"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# Expo Modules constructs GLView by reflection when a match mounts.\n-keep class expo.modules.gl.GLView { public <init>(android.content.Context, expo.modules.kotlin.AppContext); }\n# EXGLContextPrepare looks up this callback by name through JNI.\n-keepclassmembers class expo.modules.gl.GLContext { public void flush(); }"
          }
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Use your microphone when you unmute in a Ludo voice room."
      },
      "bundleIdentifier": "com.kbamnote.cgp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0f19",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.kbamnote.cgp",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "serverUrl": "https://game-ludo-backend-production.up.railway.app",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "82e0b83c-4ef5-44be-9131-65adcc6f9c50"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/82e0b83c-4ef5-44be-9131-65adcc6f9c50"
    }
  }
}
